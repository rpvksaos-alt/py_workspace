      "True\n",
      "ABC\n"
     ]
    }
   ],
   "source": [
    "my_tuple = (10,20,True)\n",
    "\n",
    "my_list = list(my_tuple)\n",
    "print(my_tuple, my_list)\n",
    "\n",
    "# 원하는 대로 update\n",
    "my_list.append('ABC')\n",
    "\n",
    "# 더이상 update x\n",
    "my_tuple2 = tuple(my_list)\n",
    "print(my_tuple2, type(my_tuple2))\n",
    "\n",
    "for data in my_tuple2 :\n",
    "    print(data)"
   ]
  }
