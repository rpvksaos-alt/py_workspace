   "source": [
    "# 중첩함수 : 함수 안에 함수 선언\n",
    "# 내부 함수는 외부 함수 안에서만 사용(호출)할 수 있다.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e9ade544",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "외부 함수 실행\n",
      "내부 함수 실행\n"
     ]
    }
   ],
   "source": [
    "def outer_func():\n",
    "    print('외부 함수 실행')\n",
    "\n",
    "    def inner_func():\n",
    "        print('내부 함수 실행')\n",
    "\n",
    "    inner_func() # 선언된 지역에서 호출\n",
    "\n",
    "outer_func()\n",
    "# inner_func() # 외부에서 호출 못함(메모리에 없음)"
   ]
  }
 ],
